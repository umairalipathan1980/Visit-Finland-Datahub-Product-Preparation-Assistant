{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analysis-request.schema.json",
  "title": "Analysis request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "product_type", "website_urls"],
  "properties": {
    "contract_version": { "const": "v1" },
    "product_type": { "enum": ["accommodation", "shops"] },
    "website_urls": {
      "type": "array",
      "items": { "type": "string", "format": "uri", "minLength": 1 },
      "minItems": 1,
      "maxItems": 10
    },
    "document_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "languages": {
      "type": "array",
      "items": { "type": "string", "enum": ["fi", "en"] },
      "default": ["fi", "en"]
    },
    "scope_confirmation": {
      "enum": ["auto_confirm_single"]
    }
  }
}
