{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canonical-accommodation.schema.json",
  "title": "Canonical accommodation record (poc-accommodation-schema-v1, provisional)",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_metadata", "product_type", "fields"],
  "$defs": {

    "day": {
      "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]
    },
    "time": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "openingHoursEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["days"],
      "properties": {
        "days": {
          "type": "array",
          "items": { "$ref": "#/$defs/day" },
          "minItems": 1,
          "uniqueItems": true
        },
        "opens": { "$ref": "#/$defs/time" },
        "closes": { "$ref": "#/$defs/time" },
        "closed": { "type": "boolean" },
        "notes": { "type": "string", "minLength": 1 }
      },
      "dependentRequired": {
        "opens": ["closes"],
        "closes": ["opens"]
      },
      "anyOf": [
        { "required": ["opens", "closes"] },
        { "required": ["closed"], "properties": { "closed": { "const": true } } },
        { "required": ["notes"] }
      ]
    },
    "openingHoursException": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "date": { "type": "string", "format": "date" },
        "label": { "type": "string", "minLength": 1 },
        "opens": { "$ref": "#/$defs/time" },
        "closes": { "$ref": "#/$defs/time" },
        "closed": { "type": "boolean" },
        "notes": { "type": "string", "minLength": 1 }
      },
      "dependentRequired": {
        "opens": ["closes"],
        "closes": ["opens"]
      },
      "anyOf": [
        { "required": ["date"] },
        { "required": ["label"] }
      ]
    },
    "openingHours": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "regular": {
          "type": "array",
          "items": { "$ref": "#/$defs/openingHoursEntry" },
          "minItems": 1
        },
        "exceptions": {
          "type": "array",
          "items": { "$ref": "#/$defs/openingHoursException" },
          "minItems": 1
        },
        "notes": { "type": "string", "minLength": 1 }
      }
    }
  },
  "properties": {
    "run_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_name", "schema_version", "category_taxonomy_version", "generated_at"],
      "properties": {
        "schema_name": { "const": "poc-accommodation-schema-v1" },
        "schema_version": { "type": "string" },
        "category_taxonomy_version": { "type": "string" },
        "generated_at": { "type": "string", "format": "date-time" }
      }
    },
    "product_type": { "const": "accommodation" },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "fi": { "type": "string" }, "en": { "type": "string" } }
        },
        "description": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "fi": { "type": "string" }, "en": { "type": "string" } }
        },
        "address": { "type": "object" },
        "coordinates": { "type": "object" },
        "contact": { "type": "object" },
        "categories": { "type": "array", "items": { "type": "string" } },
        "accessibility": { "enum": ["accessible", "non_accessible", "not_specified"] },
        "sustainability_label": {},
        "stf_status": { "enum": ["certified", "not_certified", "not_specified"] },
        "capacity": { "type": "object" },
        "pricing": { "type": "object" },
        "booking_url": { "type": "string" },
        "availability": { "type": "object" },
        "opening_hours": { "$ref": "#/$defs/openingHours" },
        "amenities": { "type": "array", "items": { "type": "string" } },
        "languages_spoken": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
